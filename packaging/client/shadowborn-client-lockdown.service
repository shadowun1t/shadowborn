[Unit]
Description=Shadowborn persistent client egress firewall
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/shadowborn-client-lockdown load
TimeoutStartSec=30
StandardOutput=null
StandardError=null
LimitCORE=0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=CAP_NET_ADMIN
RestrictAddressFamilies=AF_NETLINK AF_UNIX
